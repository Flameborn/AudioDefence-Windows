(playlist
    (name "golf")
    (preload true)
    (repeat none)

    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_hit_a")
            (extension "m4a")))
    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_hit_b")
            (extension "m4a")))
    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_hit_c")
            (extension "m4a")))
    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_miss_a")
            (extension "m4a")))
    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_miss_b")
            (extension "m4a")))
    (sound
        (bundle
            (path "sounds/_weapons/golf")
            (name "weapon_melee_golf_miss_c")
            (extension "m4a")))
)