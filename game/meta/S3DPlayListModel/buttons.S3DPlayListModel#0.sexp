(playlist
	(name "buttons")
	(repeat none)

	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "back_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "click_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "popup_appeared")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "start_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "start_level_button")
			(extension "m4a")))
)
