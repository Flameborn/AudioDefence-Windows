		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_empty")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_fire_c")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_voice")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/pistol")
			(name "weapon_gun_pistol_warning")
			(extension "m4a")))
)
