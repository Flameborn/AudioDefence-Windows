(playlist
	(name "ambient_warehouse")
	(repeat none)

	(sound
		(bundle
			(path "sounds/ambient/ambient_warehouse")
			(name "warehouse1_ambient")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/ambient/ambient_warehouse")
			(name "warehouse1_stationaryobject_SPA_1")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/ambient/ambient_warehouse")
			(name "warehouse1_stationaryobject_SPA_2")
			(extension "m4a")))
)
