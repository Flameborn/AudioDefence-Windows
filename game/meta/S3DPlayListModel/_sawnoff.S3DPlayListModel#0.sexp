(playlist
	(name "_sawnoff")
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_empty")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_fire_c")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_reloadin")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sawnoff")
			(name "weapon_gun_sawnoff_reloadout")
			(extension "m4a")))
)
