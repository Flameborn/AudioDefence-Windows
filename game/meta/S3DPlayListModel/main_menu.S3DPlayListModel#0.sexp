(playlist
	(name "main_menu")
	(repeat none)

	(sound
		(bundle
			(path "sounds/menu/main_menu")
			(name "game_over_theme")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/main_menu")
			(name "main_menu_open")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/main_menu")
			(name "main_menu_theme")
			(extension "m4a")))
)
