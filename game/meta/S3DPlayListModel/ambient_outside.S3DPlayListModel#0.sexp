	(sound
		(spatialized true)
		(bundle
			(path "sounds/ambient/ambient_outside")
			(name "outside1_stationaryobject_SPA_1")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/ambient/ambient_outside")
			(name "outside1_stationaryobject_SPA_2")
			(extension "m4a")))
)
