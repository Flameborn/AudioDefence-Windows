(playlist
	(name "policeshotgun")
	(preloaded true)
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_empty")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_fire_c")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_voice")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/policeshotgun")
			(name "weapon_gun_policeshotgun_warning")
			(extension "m4a")))
)
