(playlist
	(name "sonic")
	(preloaded true)
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_empty_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_empty_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_fire_c")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/sonic")
			(name "weapon_gun_sonic_voice")
			(extension "m4a")))
)
