(playlist
	(name "machinegun")
	(preload true)
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_conti")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_tail")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_voice")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_warning_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/machinegun")
			(name "weapon_gun_machinegun_warningloop_d")
			(extension "m4a")))
)
