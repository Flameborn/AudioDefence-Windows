			(path "sounds/passerBy/PowerUpContainer")
			(name "PowerUpContainer_death_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/passerBy/PowerUpContainer")
			(name "PowerUpContainer_spawn_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/passerBy/PowerUpContainer")
			(name "PowerUpContainer_splash_SPA ")
			(extension "m4a")))
)
