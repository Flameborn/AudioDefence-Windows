(playlist
	(name "tornado")
	(repeat none)

	(sound
		(bundle
			(path "sounds/powerup/tornado")
			(name "tornado_announce")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/tornado")
			(name "tornado_launch")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tornado")
			(name "tornado_wind_a_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tornado")
			(name "tornado_wind_b_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tornado")
			(name "tornado_wind_c_SPA")
			(extension "m4a")))
)
