(playlist
	(name "tesla_powerup")
	(repeat none)

	(sound
		(bundle
			(path "sounds/powerup/tesla_powerup")
			(name "tesla_announce")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/tesla_powerup")
			(name "tesla_launch")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tesla_powerup")
			(name "tesla_zap_a_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tesla_powerup")
			(name "tesla_zap_b_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/powerup/tesla_powerup")
			(name "tesla_zap_c_SPA")
			(extension "m4a")))
)
