(playlist
	(name "_rifle")
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/rifle")
			(name "rifle_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/rifle")
			(name "rifle_empty_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/rifle")
			(name "rifle_empty_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/rifle")
			(name "rifle_fire")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/rifle")
			(name "rifle_reload")
			(extension "m4a")))
)
