(playlist
	(name "_shotgun")
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/shotgun")
			(name "shotgun_deploy")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/shotgun")
			(name "shotgun_empty_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/shotgun")
			(name "shotgun_empty_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/shotgun")
			(name "shotgun_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/shotgun")
			(name "shotgun_reload")
			(extension "m4a")))
)
