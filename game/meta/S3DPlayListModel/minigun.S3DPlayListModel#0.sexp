(playlist
	(name "minigun")
	(repeat none)

	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_announce")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_launch_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_launch_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_tail_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/powerup/minigun")
			(name "minigun_tail_b")
			(extension "m4a")))
)
