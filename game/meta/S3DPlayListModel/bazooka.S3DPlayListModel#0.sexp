(playlist
	(name "bazooka")
	(repeat none)

	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_empty")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_explosion_a_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_explosion_b_SPA")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_fire_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_fire_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_move_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_move_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_reloadfull")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/_weapons/bazooka")
			(name "weapon_gun_bazooka_voice")
			(extension "m4a")))
)
