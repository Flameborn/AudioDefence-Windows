(playlist
	(name "revive")
	(repeat none)

	(sound
		(bundle
			(path "sounds/revive")
			(name "revive_no")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/revive")
			(name "revive_standby")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/revive")
			(name "revive_yes")
			(extension "m4a")))
)
